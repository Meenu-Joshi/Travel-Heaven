<% layout('layout/boilerplate') -%>
<style>
    :root {
        --primary-red: #fe424d;
        --glass: rgba(255, 255, 255, 0.15);
    }

    body {
        overflow-x: hidden; /* Crucial to prevent horizontal scrolling on mobile */
    }

    /* Responsive Hero Wrapper */
    .hero-container {
        position: relative;
        height: 100vh;
        width: 100%;
        margin-top: -100px;
        background: #020d18;
        overflow: hidden;
    }

    .hero-video-bg {
        position: absolute;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.6;
        animation: slowZoom 20s infinite alternate;
    }

    @keyframes slowZoom {
        from { transform: scale(1); }
        to { transform: scale(1.1); }
    }

    .hero-overlay {
        position: relative;
        z-index: 10;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
        padding: 0 15px; /* Better padding for mobile screens */
    }

    /* Mobile-responsive fluid typography */
    .brand-title {
        font-size: clamp(2.5rem, 8vw, 6.5rem);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 3px;
        margin-bottom: 10px;
        text-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    /* Responsive Glass Card */
    .glass-cta {
        background: var(--glass);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.2);
        padding: 30px 20px;
        border-radius: 24px;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);
        max-width: 600px;
        width: 100%;
    }

    /* Responsive Airplane Path */
    .airplane-path {
        position: absolute;
        top: 25%;
        left: -15%;
        z-index: 5;
        font-size: clamp(2rem, 5vw, 3.5rem); /* Scales down on mobile */
        color: rgba(255,255,255,0.8);
        animation: flyAcross 18s linear infinite;
        transform: rotate(15deg);
    }

    @keyframes flyAcross {
        0% { left: -15%; top: 35%; }
        100% { left: 115%; top: 15%; }
    }

    /* Layered Responsive Waves */
    .waves-container {
        position: absolute;
        bottom: 0;
        width: 100%;
        height: 10vh; /* Scaled dynamically with viewport height */
        min-height: 60px;
        z-index: 6;
    }

    .parallax-waves > use {
        animation: move-forever 25s cubic-bezier(.55,.5,.45,.5) infinite;
    }
    .parallax-waves > use:nth-child(1) { animation-delay: -2s; animation-duration: 7s; }
    .parallax-waves > use:nth-child(2) { animation-delay: -3s; animation-duration: 10s; }
    .parallax-waves > use:nth-child(3) { animation-delay: -4s; animation-duration: 13s; }
    .parallax-waves > use:nth-child(4) { animation-delay: -5s; animation-duration: 20s; }

    @keyframes move-forever {
        0% { transform: translate3d(-90px,0,0); }
        100% { transform: translate3d(85px,0,0); }
    }

    .btn-glow {
        background: var(--primary-red);
        color: white;
        border: none;
        padding: 14px 35px;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1rem;
        transition: 0.3s ease;
        width: 100%; /* Full-width buttons look cleaner on mobile stacked grids */
        max-width: 250px;
    }

    .btn-glow:hover {
        box-shadow: 0 0 25px var(--primary-red);
        transform: scale(1.03);
        color: white;
    }

    /* --- MOBILE-FRIENDLY FLOATING CHATBOT WIDGET --- */
    #chatbot-widget {
        position: fixed;
        bottom: 25px;
        right: 25px;
        z-index: 1000;
        font-family: inherit;
    }

    .chat-btn {
        width: 60px;
        height: 60px;
        border-radius: 50px;
        background: var(--primary-red);
        color: white;
        border: none;
        box-shadow: 0 8px 24px rgba(254, 66, 77, 0.4);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        transition: transform 0.3s ease;
    }

    .chat-btn:hover {
        transform: scale(1.05);
    }

    .chat-window {
        position: absolute;
        bottom: 75px;
        right: 0;
        width: 350px;
        height: 450px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.15);
        display: none; /* Hidden by default */
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #eee;
    }

    .chat-header {
        background: var(--primary-red);
        color: white;
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: bold;
    }

    .chat-body {
        flex-grow: 1;
        padding: 15px;
        overflow-y: auto;
        background: #f8f9fa;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .chat-msg {
        max-width: 80%;
        padding: 10px 14px;
        border-radius: 15px;
        font-size: 0.9rem;
    }

    .chat-msg.bot {
        background: white;
        align-self: flex-start;
        border-bottom-left-radius: 2px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }

    .chat-msg.user {
        background: var(--primary-red);
        color: white;
        align-self: flex-end;
        border-bottom-right-radius: 2px;
    }

    .chat-footer {
        padding: 10px;
        background: white;
        border-top: 1px solid #eee;
        display: flex;
        gap: 8px;
    }

    .chat-footer input {
        flex-grow: 1;
        border: 1px solid #ddd;
        border-radius: 20px;
        padding: 8px 15px;
        outline: none;
    }

    /* Media Queries for fine-tuning phone responsive UI */
    @media (max-width: 576px) {
        .glass-cta {
            padding: 25px 15px;
        }
        .brand-title {
            letter-spacing: 1px;
        }
        .chat-window {
            position: fixed;
            bottom: 0;
            right: 0;
            width: 100vw;
            height: 100vh;
            border-radius: 0;
            z-index: 1001;
        }
        .chat-window.active {
            display: flex;
        }
    }
</style>

<div class="hero-container">
    <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?q=80&w=2070" class="hero-video-bg" alt="Background">
    
    <div class="hero-overlay">
        <h1 class="brand-title">ExploreVista</h1>
        <div class="glass-cta">
            <h2 class="fs-4 fw-light mb-3">Your Passport to Unique Stays</h2>
            <p class="text-white-50 small mb-4">Discover, book, and host with confidence on the most trusted travel community.</p>
            <a href="/listings" class="btn btn-glow">Start Adventure</a>
        </div>
    </div>

    <div class="airplane-path">
        <i class="fa-solid fa-plane"></i>
    </div>

    <svg class="waves-container" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"
    viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
        <defs>
            <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
        </defs>
        <g class="parallax-waves">
            <use xlink:href="#gentle-wave" x="48" y="0" fill="rgba(255,255,255,0.7" />
            <use xlink:href="#gentle-wave" x="48" y="3" fill="rgba(255,255,255,0.5)" />
            <use xlink:href="#gentle-wave" x="48" y="5" fill="rgba(255,255,255,0.3)" />
            <use xlink:href="#gentle-wave" x="48" y="7" fill="#fff" />
        </g>
    </svg>
</div>

<div class="container py-5 my-3">
    <div class="row text-center g-4">
        <div class="col-12 col-md-4">
            <div class="p-4 border rounded-4 shadow-sm h-100">
                <div class="bg-danger-subtle p-3 rounded-circle d-inline-block mb-3">
                    <i class="fa-solid fa-hotel fa-2x text-danger"></i>
                </div>
                <h3>Premium Stays</h3>
                <p class="text-muted">Explore handpicked listings from Pathankot to around the world.</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="p-4 border rounded-4 shadow-sm h-100">
                <div class="bg-primary-subtle p-3 rounded-circle d-inline-block mb-3">
                    <i class="fa-solid fa-user-shield fa-2x text-primary"></i>
                </div>
                <h3>Safe & Secure</h3>
                <p class="text-muted">Advanced security with hashed passwords and admin-led moderation.</p>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="p-4 border rounded-4 shadow-sm h-100">
                <div class="bg-success-subtle p-3 rounded-circle d-inline-block mb-3">
                    <i class="fa-solid fa-map-location-dot fa-2x text-success"></i>
                </div>
                <h3>Live Maps</h3>
                <p class="text-muted">Interactive Mapbox exploration to visualize your destination.</p>
            </div>
        </div>
    </div>
</div>

<div id="chatbot-widget">
    <button class="chat-btn" onclick="toggleChat()"><i class="fa-solid fa-comment-dots"></i></button>
    <div class="chat-window" id="chatWindow">
        <div class="chat-header">
            <span><i class="fa-solid fa-robot"></i> VistaBot Help</span>
            <button class="btn btn-sm text-white border-0" onclick="toggleChat()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="chat-body" id="chatBody">
            <div class="chat-msg bot">Hello! Welcome to ExploreVista support. How can I assist you with your destination lookup or account setting today?</div>
        </div>
        <div class="chat-footer">
            <input type="text" id="chatInput" placeholder="Type a message..." onkeypress="handleKeyPress(event)">
            <button class="btn btn-danger btn-sm rounded-circle" onclick="sendMessage()"><i class="fa-solid fa-paper-plane"></i></button>
        </div>
    </div>
</div>

<script>
    function toggleChat() {
        const win = document.getElementById('chatWindow');
        if (win.style.display === 'flex') {
            win.style.display = 'none';
        } else {
            win.style.display = 'flex';
            // Scroll to bottom
            const body = document.getElementById('chatBody');
            body.scrollTop = body.scrollHeight;
        }
    }

    function handleKeyPress(e) {
        if (e.key === 'Enter') sendMessage();
    }

    function sendMessage() {
        const input = document.getElementById('chatInput');
        const body = document.getElementById('chatBody');
        const text = input.value.trim();
        
        if (!text) return;

        // Render User Message
        body.innerHTML += `<div class="chat-msg user">${text}</div>`;
        input.value = '';
        body.scrollTop = body.scrollHeight;

        // Dynamic Automated Responses
        setTimeout(() => {
            let botReply = "I'm sorry, I didn't quite catch that. You can type 'admin', 'listings', or 'password' for contextual help.";
            const lowerText = text.toLowerCase();

            if (lowerText.includes('admin') || lowerText.includes('contact')) {
                botReply = "You can contact our support admins instantly via email at <strong>admin@explorevista.com</strong>.";
            } else if (lowerText.includes('listing') || lowerText.includes('book')) {
                botReply = "To look at properties, exit to the main page and hit the 'Start Adventure' or 'Explore' button in the navbar!";
            } else if (lowerText.includes('password') || lowerText.includes('reset')) {
                botReply = "If your password reset token is expired, go back to the login page and trigger a fresh link via 'Forgot Password'.";
            }

            body.innerHTML += `<div class="chat-msg bot">${botReply}</div>`;
            body.scrollTop = body.scrollHeight;
        }, 800);
    }
</script>