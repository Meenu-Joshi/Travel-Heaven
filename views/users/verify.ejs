<% layout('layout/boilerplate') -%>
<div class="row mt-3 offset-3">
    <h2>Verify your <%= type %></h2>
    <form action="/verify/<%= type %>" method="POST">
        <div class="mb-3 col-6">
            <label for="otp" class="form-label">Enter 6-Digit OTP</label>
            <input type="text" name="otp" class="form-control" required maxlength="6">
        </div>
        <button class="btn btn-primary">Verify</button>
    </form>
</div>