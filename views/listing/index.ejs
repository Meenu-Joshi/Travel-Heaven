<% layout('layout/boilerplate') -%>

<style>
   
    /* Filter Container - Enables horizontal scrolling on mobile */
    .filters-container {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 1rem 0;
    overflow-x: auto;
    background-color: white; /* Add this so navbar doesn't look transparent over it */
    position: sticky;
    top: 5rem; /* This keeps it right below your sticky navbar */
    z-index: 10;
    white-space: nowrap;
}

    /* Hide scrollbar for cleaner UI */
    .filters-container::-webkit-scrollbar {
        display: none;
    }

    /* Individual Filter Icon Style */
    .filter {
        text-align: center;
        margin-right: 2rem;
        opacity: 0.7;
        cursor: pointer;
        flex: 0 0 auto; /* Prevents icons from shrinking */
        transition: 0.2s;
        flex: 0 0 auto; /* CRITICAL: Prevents icons from shrinking or overlapping */

    
    }

    .filter:hover {
        opacity: 1;
        border-bottom: 2px solid #222;
    }

    .filter i {
        font-size: 1.2rem;
    }
    

    .filter p {
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    /* Tax Switch Container */
    .tax-toggle {
        border: 1px solid rgba(0, 0, 0, 0.15);
        border-radius: 1rem;
        padding: 0.6rem 1rem;
        display: flex;
        align-items: center;
        margin-left: auto; /* Pushes to the right on desktop */
        flex-shrink: 0;
        background-color: #fff;
    }

    .taxInfo {
        display: none; /* Initially hidden [cite: 17] */
        color: #fe424d;
        font-weight: 600;
    }

    /* Mobile Responsive Adjustments */
    @media (max-width: 992px) {
        .tax-toggle {
            margin-left: 1rem; /* Space after icons on smaller screens */
        }
    }

    @media (max-width: 768px) {
        .filters-container {
            padding: 0.5rem;
        }
        .tax-toggle {
            width: 100%; /* Full width on mobile to prevent overlap */
            justify-content: center;
            margin: 1rem 0;
        }
    }
    @media (max-width: 600px) {
    .filters-container {
        flex-wrap: wrap; /* Allows the switch to move to a new line */
        justify-content: center;
    }
    .tax-toggle {
        margin-left: 0;
        margin-top: 1rem;
        width: 100%;
    }
}
@media (max-width: 768px) {
    .tax-toggle {
        margin-left: 1rem;
        width: auto;
    }
}


    
    .filter:hover {
        opacity: 1;
        border-bottom: 2px solid #222;
    }

    .tax-toggle {
        border: 1px solid #ccc;
        border-radius: 1rem;
        padding: 0.5rem 1rem;
        margin-left: auto; /* Desktop: Pushes to the right */
        display: flex;
        align-items: center;
        flex-shrink: 0;
        background-color: white;
    }

    @media (max-width: 992px) {
        .tax-toggle {
            margin-left: 1rem; /* Adjusts for medium screens */
        }
    }
</style>

<div class="filters-container mt-2">
    <div class="filter">
        <i class="fa-solid fa-fire"></i>
        <p>Trending</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-bed"></i>
        <p>Rooms</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-mountain-city"></i>
        <p>Iconic Cities</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-water-ladder"></i>
        <p>Amazing Pools</p>
    </div>
    <div class="filter">
        <i class="fa-brands fa-fort-awesome"></i>
        <p>Castles</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-mountain"></i>
        <p>Mountains</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-snowman"></i>
        <p>Arctic</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-cow"></i>
        <p>Farm</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-anchor"></i>
        <p>Houseboats</p>
    </div>
    <div class="filter">
        <i class="fa-solid fa-route"></i>
        <p>Camping</p>
    </div>

    <div class="tax-toggle">
        <div class="form-check form-switch form-check-reverse">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>



<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3"> 
    <% for(let listing of listings) { %> 
        <a href="/listings/<%=listing._id %>" class="card-links"> 
            <div class="card col listing-card">
                <img src="<%= listing.image.url%>" class="card-img-top" alt="listing Image">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%= listing.title %></b><br/>
                        &#x20B9; <%=listing.price.toLocaleString("en-IN")%> / night
                        <i class="taxInfo">&nbsp; &nbsp; +18% GST</i> 
                    </p>
                </div>
            </div>
        </a>
    <% } %>
</div> 

<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("taxInfo");
        for(let info of taxInfo) {
            if(info.style.display !== "inline") {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }   
    });
</script>


