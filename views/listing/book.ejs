<% layout('layout/boilerplate') -%>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h2>Book: <%= listing.title %></h2>
        <form method="POST" action="/listings/<%= listing._id %>/confirm" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="checkIn" class="form-label">Check-in Date</label>
                <input type="date" name="booking[checkIn]" class="form-control" id="checkIn" required>
            </div>
            <div class="mb-3">
                <label for="checkOut" class="form-label">Check-out Date</label>
                <input type="date" name="booking[checkOut]" class="form-control" id="checkOut" required>
            </div>
            <div class="mb-3">
                <label for="guests" class="form-label">Number of Guests</label>
                <input type="number" name="booking[guests]" class="form-control" min="1" required>
            </div>
            <button class="btn btn-danger">Confirm Booking</button>
        </form>
    </div>
</div>

<script>
const checkInInput = document.getElementById('checkIn');
const checkOutInput = document.getElementById('checkOut');

// 1. Set minimum check-in as today
const today = new Date().toISOString().split('T')[0];
checkInInput.setAttribute('min', today);

// 2. Lock the Check-out calendar based on Check-in
checkInInput.addEventListener('change', function() {
    if (this.value) {
        let selectedDate = new Date(this.value);
        // Standard hotel logic: Checkout must be at least the next day
        selectedDate.setDate(selectedDate.getDate() + 1);
        
        let minCheckOut = selectedDate.toISOString().split('T')[0];
        checkOutInput.setAttribute('min', minCheckOut);
        
        // Clear check-out if it becomes invalid
        if (checkOutInput.value && checkOutInput.value < minCheckOut) {
            checkOutInput.value = "";
        }
    }
});
</script>