<% layout('layout/boilerplate') -%>
<div class="row mt-3">
    <div class="col-6 offset-3 text-center">
        <div class="alert alert-success p-5 shadow">
            <i class="fa-solid fa-circle-check fa-4x mb-3 text-success"></i>
            <h2 class="mt-3">Your Booking is Done!</h2>
            
            <% if (successMsg && successMsg.length) { %>
                <p class="lead"><%= successMsg %></p>
            <% } else { %>
                <p class="lead">Your stay has been successfully reserved.</p>
            <% } %>
            
            <hr>
            <div class="d-grid gap-2">
                <a href="/listings" class="btn btn-primary">Back to Destinations</a>
                <button class="btn btn-outline-dark" onclick="window.print()">Print Receipt</button>
            </div>
        </div>
    </div>
</div>