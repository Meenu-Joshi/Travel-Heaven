<% layout('layout/boilerplate') -%>
<body>
    <div class="row col-8 offset-1">
        <h3 class="mt-3"> <b><%=listing.title%></b></h3>
        <div class="card listing-card">
            <img src="<%=listing.image.url %>" class="card-img-top listing-image" alt="listing-image">
            <div class="card-body">
                <p class="card-text mt-3"> Created by: <i><%= listing.owner ? listing.owner.username : "System" %></i></p>
                <p class="card-body"><%=listing.description%> </p>
                <p class="card-body">  &#8377 <%=listing.price.toLocaleString("en-IN")%></p>
                <p class="card-body"><%=listing.country%></p>
            </div>
        </div>
    </div>
    
    <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="btns offset-2 d-flex justify-content-between align-items-center">
            <div class="d-flex">
                <a href="/listings/<%=listing._id%>/edit" class="btn show-edit-btn me-2">Edit</a>
                <form method="POST" action="/listings/<%=listing._id%>/delete?_method=DELETE">
                    <button class="btn btn-dark show-dlt-btn offset-2">Delete</button>
                </form>
            </div>
            <a href="/listings/<%= listing._id %>/bookings/book" class="btn btn-danger book-btn">Book Now</a>
        </div>
    <% } %>

    <br>

    <div class="row offset-1 mt-3">
        <div class="col-8">
            <div class="card" id="weather-widget">
                <div class="card-body text-center">
                    <h5 class="card-title"><i class="fa-solid fa-cloud-sun"></i> Weather Information</h5>
                    <p class="card-text">Check the current weather conditions at this destination.</p>
                    <button class="btn btn-outline-primary" onclick="fetchWeather(<%= listing.geometry.coordinates[1] %>, <%= listing.geometry.coordinates[0] %>)">
                        Load Weather Data
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row offset-1 mt-3">
        <div class="col-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><i class="fa-solid fa-leaf"></i> Smart Carbon Footprint Calculator</h5>
                    <form id="footprint-form" onsubmit="event.preventDefault(); calculateFootprint();">
                        <div class="mb-3">
                            <label for="transport" class="form-label">Select Transport Mode:</label>
                            <select class="form-select" id="transport" name="transport">
                                <option value="flight">Flight (0.25 kg CO₂/km)</option>
                                <option value="car">Car (0.15 kg CO₂/km)</option>
                                <option value="train">Train (0.05 kg CO₂/km)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success">Calculate</button>
                    </form>
                    <p id="footprint-result" class="mt-3"></p>
                </div>
            </div>
        </div>
    </div>

    <div class="row offset-1">
        <hr>
        <% if (currUser) { %>
        <h4>Leave a review</h4>
        <div class="col-8">
            <form method="post" action="/listings/<%=listing._id%>/reviews" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <legend>First rating:</legend>
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                        <label for="second-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                        <label for="second-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                        <label for="second-rate3" title="Average">3 stars</label>
                        <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                        <label for="second-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                        <label for="second-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <label for="comments" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comments" cols="30" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">
                        Add comments 
                    </div>
                </div>
                <button class="btn btn-outline-dark mb-3">Submit</button>
            </form>
        </div>
        <% } %>

        <div>
            <h4>All Reviews</h4>
            <div class="row">
                <% for(let review of listing.reviews) { %>
                <div class="card mb-3 col-5 ms-3">
                    <div class="card-body">
                        <div class="card-title">@<%=review.author.username %></div>
                        <div class="card-text">
                            <p class="starability-result" data-rating=<%=review.rating %>></p>
                            <p><%= review.comment %></p>
                        </div>
                        <form method="Post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                            <button class="btn btn-sm btn-dark mb-3">Delete</button>
                        </form>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-8 offset-3 mb-3">
        <h3>Where you’ll be</h3>
        <div id="map" style="height: 400px; width: 100%;"></div>
    </div>

    <script>
        // 1. Set Access Token
        mapboxgl.accessToken = "<%= process.env.MAPBOX_TOKEN %>";

        // 2. Safely parse coordinates from EJS to JS
        const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;

        // 3. Initialize the map
        const map = new mapboxgl.Map({
            container: 'map', 
            style: 'mapbox://styles/mapbox/streets-v12', 
            center: coordinates,
            zoom: 9
        });

        // 4. Add the marker
        new mapboxgl.Marker({ color: "red" })
            .setLngLat(coordinates)
            .setPopup(
                new mapboxgl.Popup({ offset: 25 })
                .setHTML("<h4><%= listing.title %></h4><p>Exact location provided after booking</p>")
            )
            .addTo(map);

        // 5. Fetch weather data function
        async function fetchWeather(lat, lon) {
            const apiKey = "<%= process.env.WEATHER_API_KEY %>";
            try {
                const response = await fetch(`https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&units=metric&appid=${apiKey}`);
                const data = await response.json();
                
                if(response.ok) {
                    document.getElementById("weather-widget").innerHTML = `
                        <div class="card-body">
                            <h5 class="card-title"><i class="fa-solid fa-cloud-sun"></i> Weather at Destination</h5>
                            <p class="card-text"><strong>${data.name}, ${data.sys.country}</strong></p>
                            <p>Temperature: ${data.main.temp}°C</p>
                            <p>Condition: ${data.weather[0].description}</p>
                        </div>
                    `;
                } else {
                    document.getElementById("weather-widget").innerHTML = `
                        <div class="card-body text-danger">
                            <p>Could not retrieve weather information.</p>
                        </div>
                    `;
                }
            } catch (err) {
                console.error("Could not load weather data", err);
            }
        }

        // 6. Carbon footprint execution logic
        function calculateFootprint() {
            const transport = document.getElementById("transport").value;
            const baseDistance = 500; // Estimated travel distance
            const factors = { flight: 0.25, car: 0.15, train: 0.05 };
            
            const result = (baseDistance * factors[transport]).toFixed(2);
            document.getElementById("footprint-result").innerHTML = 
                `Estimated emissions for a ${baseDistance} km trip: <b>${result} kg CO₂</b>.`;
        }
    </script>
</body>


 
 
  
  