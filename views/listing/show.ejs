<% layout('layout/boilerplate') -%>
<body>
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.0.0/mapbox-gl.css" rel="stylesheet" />
    <script src="https://api.mapbox.com/mapbox-gl-js/v3.0.0/mapbox-gl.js"></script>

    <link rel="stylesheet" href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-directions/v4.1.1/mapbox-gl-directions.css" type="text/css">
    <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-directions/v4.1.1/mapbox-gl-directions.js"></script>

    <div class="row col-8 offset-1">
        <h3 class="mt-3"> <b><%=listing.title%></b></h3>
        <div class="card listing-card">
            <img src="<%=listing.image.url %>" class="card-img-top listing-image" alt="listing-image">
            <div class="card-body">
                <p class="card-text mt-3"> Created by: <i><%= listing.owner ? listing.owner.username : "System" %></i></p>
                
                <p class="card-body"><%=listing.description%> </p>
                <p class="card-body">  &#8377 <%=listing.price.toLocaleString("en-IN")%></p>
                <p class="card-body"><%=listing.country%></p>
            </div>
        </div>
    </div>
    
    <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
        <div class="btns offset-2 d-flex justify-content-between align-items-center">
            <div class="d-flex">
                <a href="/listings/<%=listing._id%>/edit" class="btn show-edit-btn me-2">Edit</a>
                <form method="POST" action="/listings/<%=listing._id%>/delete?_method=DELETE">
                    <button class="btn btn-dark show-dlt-btn offset-2">Delete</button>
                </form>
            </div>
            <a href="/listings/<%= listing._id %>/bookings/book" class="btn btn-danger book-btn">Book Now</a>
        </div>
    <% } %>

    <br>

    <div class="row offset-1 mt-3">
        <div class="col-8">
            <div class="card" id="weather-widget">
                <div class="card-body text-center">
                    <h5 class="card-title"><i class="fa-solid fa-cloud-sun"></i> Weather Information</h5>
                    <p class="card-text">Check the current weather conditions at this destination.</p>
                    <button class="btn btn-outline-primary" onclick="fetchWeather(<%= listing.geometry.coordinates[1] %>, <%= listing.geometry.coordinates[0] %>)">
                        Load Weather Data
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row offset-1 mt-3">
        <div class="col-8">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title"><i class="fa-solid fa-leaf"></i> Smart Carbon Footprint Calculator</h5>
                    <form id="footprint-form" onsubmit="event.preventDefault(); calculateFootprint();">
                        <div class="mb-3">
                            <label for="transport" class="form-label">Select Transport Mode:</label>
                            <select class="form-select" id="transport" name="transport">
                                <option value="flight">Flight (0.25 kg CO₂/km)</option>
                                <option value="car">Car (0.15 kg CO₂/km)</option>
                                <option value="train">Train (0.05 kg CO₂/km)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-success">Calculate</button>
                    </form>
                    <p id="footprint-result" class="mt-3"></p>
                </div>
            </div>
        </div>
    </div>

    <div class="row offset-1">
        <hr>
        <% if (currUser) { %>
        <h4>Leave a review</h4>
        <div class="col-8">
            <form method="post" action="/listings/<%=listing._id%>/reviews" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <legend>First rating:</legend>
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                        <label for="second-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                        <label for="second-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                        <label for="second-rate3" title="Average">3 stars</label>
                        <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                        <label for="second-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                        <label for="second-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <label for="comments" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comments" cols="30" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">
                        Add comments 
                    </div>
                </div>
                <button class="btn btn-outline-dark mb-3">Submit</button>
            </form>
        </div>
        <% } %>

        <div>
            <h4>All Reviews</h4>
            <div class="row">
                <% for(let review of listing.reviews) { %>
                <div class="card mb-3 col-5 ms-3">
                    <div class="card-body">
                        <div class="card-title">@<%=review.author.username %></div>
                        <div class="card-text">
                            <p class="starability-result" data-rating=<%=review.rating %>></p>
                            <p><%= review.comment %></p>
                        </div>
                        <form method="Post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                            <button class="btn btn-sm btn-dark mb-3">Delete</button>
                        </form>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <div class="col-8 offset-3 mb-3">
        <h3>Where you’ll be</h3>
        <div id="map" style="height: 400px; width: 100%;"></div>
        <button class="btn btn-primary mt-3 mb-3" onclick="loadLiveRoute()">See Route</button>
    </div>

    <script>
    // 1. Initialize Variables from Controller [cite: 23, 27, 37]
    const mapToken = "<%= mapToken %>";
    const weatherKey = "<%= weatherApiKey %>"; 
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    
    mapboxgl.accessToken = mapToken;

    // 2. Initialize the Map [cite: 24]
    const map = new mapboxgl.Map({
        container: 'map', 
        style: 'mapbox://styles/mapbox/streets-v12', 
        center: coordinates,
        zoom: 9
    });

    // 3. Add Static Destination Marker [cite: 25]
    new mapboxgl.Marker({ color: "red" })
        .setLngLat(coordinates)
        .setPopup(
            new mapboxgl.Popup({ offset: 25 })
            .setHTML("<h4><%= listing.title %></h4><p>Destination</p>")
        )
        .addTo(map);

    // 4. Live Tracking & Route Function [cite: 28, 31, 32]
    let directionsLoaded = false;
    let watchId = null;

    function loadLiveRoute() {
        if (!mapboxgl.accessToken || mapboxgl.accessToken === "" || mapboxgl.accessToken === "undefined") {
            console.error("Mapbox Token is missing!");
            return alert("Error: Mapbox token not configured correctly.");
        }
        
        if (directionsLoaded) return;

        const btn = document.querySelector("button[onclick='loadLiveRoute()']");
        if (btn) btn.innerText = "Tracking your movement...";

        const directions = new MapboxDirections({
            accessToken: mapboxgl.accessToken,
            unit: 'metric',
            profile: 'mapbox/driving-traffic',
            controls: { inputs: true, instructions: true }
        });

        map.addControl(directions, 'top-left');
        directions.setDestination(coordinates);

        if (navigator.geolocation) {
            // watchPosition creates a live link to the user's GPS [cite: 31]
            watchId = navigator.geolocation.watchPosition(
                position => {
                    const userLoc = [position.coords.longitude, position.coords.latitude];
                    
                    // Update the route origin in real-time [cite: 32]
                    directions.setOrigin(userLoc);
                    
                    // Move the camera to follow the user [cite: 33]
                    map.flyTo({
                        center: userLoc,
                        speed: 0.8,
                        essential: true 
                    });

                    if (btn) btn.innerText = "Live Tracking Active";
                    directionsLoaded = true;
                }, 
                error => {
                    console.error("Tracking error:", error);
                    alert("GPS signal lost. Please enable location permissions.");
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        } else {
            alert("Your browser doesn't support live tracking.");
        }
    }

    // 5. Weather Functionality Fix [cite: 37, 38]
    async function fetchWeather(lat, lon) {
        if (!weatherKey) return console.error("Weather API key missing");
        
        try {
            const response = await fetch(`https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&units=metric&appid=${weatherKey}`);
            const data = await response.json();
            
            if (response.ok) {
                document.getElementById("weather-widget").innerHTML = `
                    <div class="card-body">
                        <h5 class="card-title">Weather at Destination</h5>
                        <p><strong>${data.name}</strong>: ${data.main.temp}°C</p>
                        <p>Condition: ${data.weather[0].description}</p>
                    </div>`;
            }
        } catch (err) { console.error("Weather failed", err); }
    }

    // 6. Carbon Footprint [cite: 45, 47]
    function calculateFootprint() {
        const transport = document.getElementById("transport").value;
        const dist = 500; 
        const factors = { flight: 0.25, car: 0.15, train: 0.05 };
        const result = (dist * factors[transport]).toFixed(2);
        document.getElementById("footprint-result").innerHTML = 
            `Estimated emissions for a ${dist} km trip: <b>${result} kg CO₂</b>.`;
    }
</script>
</body>