<% layout('layout/boilerplate') -%>
<style>
    body {
        overflow-x: hidden;
    }
    .listing-card img {
        height: 50vh;
        object-fit: cover;
        border-radius: 15px;
    }
    .starability-slot {
        min-height: 40px;
    }
    /* Responsive Map Height adjustments */
    #map {
        height: 400px;
        width: 100%;
        border-radius: 15px;
    }
    @media (max-width: 576px) {
        .listing-card img {
            height: 35vh;
        }
        #map {
            height: 280px;
        }
    }
</style>

<div class="container mt-3 px-3">
    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h3 class="mb-3"><b><%=listing.title%></b></h3>
            <div class="card listing-card border-0 shadow-sm">
                <img src="<%=listing.image.url %>" class="card-img-top listing-image" alt="listing-image" loading="lazy">
                <div class="card-body px-2">
                    <p class="card-text mt-3">Created by: <i><%= listing.owner ? listing.owner.username : "System" %></i></p>
                    <p class="card-text text-muted"><%=listing.description%></p>
                    <p class="card-text fw-bold">&#8377; <%=listing.price.toLocaleString("en-IN")%></p>
                    <p class="card-text"><i class="fa-solid fa-globe"></i> <%=listing.country%></p>
                </div>
            </div>
        </div>
    </div>
    
   
       <div class="row my-4">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
            
            <div class="d-flex gap-2">
                <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
                    <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark px-4 rounded-3">Edit</a>
                    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                        <button class="btn btn-outline-danger rounded-3">Delete</button>
                    </form>
                <% } %>
            </div>

            <% if (currUser && !currUser._id.equals(listing.owner._id)) { %>
                <a href="/listings/<%= listing._id %>/bookings/book" class="btn btn-danger px-4 rounded-3">Book Now</a>
            <% } else if (!currUser) { %>
                <a href="/login" class="btn btn-outline-danger px-4 rounded-3">Log in to Book</a>
            <% } %>

        </div>
    </div>
</div>
  

    <hr class="col-12 col-md-10 col-lg-8 mx-auto">

    <div class="row g-3 justify-content-center">
        <div class="col-12 col-md-5 col-lg-4">
            <div class="card h-100 shadow-sm border-0" id="weather-widget">
                <div class="card-body text-center d-flex flex-column justify-content-center align-items-center">
                    <h5 class="card-title text-primary"><i class="fa-solid fa-cloud-sun"></i> Weather</h5>
                    <p class="card-text text-muted small">Check current atmospheric configurations.</p>
                    <button class="btn btn-sm btn-outline-primary rounded-5" onclick="fetchWeather(<%= listing.geometry.coordinates[1] %>, <%= listing.geometry.coordinates[0] %>)">
                        Load Data
                    </button>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-5 col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h5 class="card-title text-success"><i class="fa-solid fa-leaf"></i> Carbon Calculator</h5>
                    <form id="footprint-form" onsubmit="event.preventDefault(); calculateFootprint();">
                        <div class="mb-2">
                            <select class="form-select form-select-sm" id="transport" name="transport">
                                <option value="flight">Flight (0.25 kg CO₂/km)</option>
                                <option value="car">Car (0.15 kg CO₂/km)</option>
                                <option value="train">Train (0.05 kg CO₂/km)</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-sm btn-success w-100 rounded-5">Calculate</button>
                    </form>
                    <p id="footprint-result" class="mt-2 small text-center fw-bold text-muted"></p>
                </div>
            </div>
        </div>
    </div>

    <hr class="col-12 col-md-10 col-lg-8 mx-auto my-4">

    <div class="row">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <% if (currUser) { %>
            <h4 class="mb-3">Leave a review</h4>
            <form method="post" action="/listings/<%=listing._id%>/reviews" novalidate class="needs-validation">
                <div class="mb-3">
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="second-rate1" name="review[rating]" value="1" />
                        <label for="second-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="second-rate2" name="review[rating]" value="2" />
                        <label for="second-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="second-rate3" name="review[rating]" value="3" />
                        <label for="second-rate3" title="Average">3 stars</label>
                        <input type="radio" id="second-rate4" name="review[rating]" value="4" />
                        <label for="second-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="second-rate5" name="review[rating]" value="5" />
                        <label for="second-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <label for="comments" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comments" cols="30" rows="4" class="form-control" required></textarea>
                    <div class="invalid-feedback">Add comments</div>
                </div>
                <button class="btn btn-outline-dark mb-4 px-4 rounded-3">Submit</button>
            </form>
            <% } %>

            <h4 class="mt-2">All Reviews</h4>
            <div class="row g-3">
                <% for(let review of listing.reviews) { %>
                <div class="col-12 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 p-2">
                        <div class="card-body">
                            <h6 class="card-title fw-bold">@<%=review.author.username %></h6>
                            <p class="starability-result" data-rating=<%=review.rating %>></p>
                            <p class="card-text small text-muted"><%= review.comment %></p>
                            <form method="Post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mt-2">
                                <button class="btn btn-sm btn-link text-danger p-0 border-0 text-decoration-none">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
    </div>

    <hr class="col-12 col-md-10 col-lg-8 mx-auto my-4">

    <div class="row mb-5">
        <div class="col-12 col-md-10 col-lg-8 mx-auto">
            <h3>Where you’ll be</h3>
            <div id="map"></div>
            <button class="btn btn-primary w-100 mt-3 rounded-5 py-2" onclick="loadLiveRoute()"><i class="fa-solid fa-location-crosshairs"></i> See Route</button>
        </div>
    </div>
</div>

<script>
    const mapToken = "<%- mapToken %>";
    const weatherKey = "<%- weatherApiKey %>"; 
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    
    mapboxgl.accessToken = mapToken;

    const map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/streets-v12', 
        center: coordinates,
        zoom: 9
    });

    new mapboxgl.Marker({ color: "red" })
        .setLngLat(coordinates)
        .setPopup(
            new mapboxgl.Popup({ offset: 25 })
            .setHTML("<h4><%= listing.title %></h4><p>Destination</p>")
        )
        .addTo(map);

    let directionsLoaded = false;
    let watchId = null;
    let directions = null; 

    function loadLiveRoute() {
        if (!mapToken || mapToken === "" || mapToken === "undefined") {
            return alert("Error: Mapbox token not configured correctly.");
        }
        
        mapboxgl.accessToken = mapToken;
        if (directionsLoaded) return;
        const btn = document.querySelector("button[onclick='loadLiveRoute()']");
        if (btn) btn.innerText = "Tracking your movement...";

        const transportMode = document.getElementById("transport").value;
        let mapboxProfile = 'mapbox/driving-traffic';
        if (transportMode === 'train') {
            mapboxProfile = 'mapbox/walking';
        }

        directions = new MapboxDirections({
    accessToken: mapboxgl.accessToken,
    unit: 'metric',
    profile: mapboxProfile, 
    controls: { 
        inputs: true, 
        instructions: true // This brings back the live duration/time display
    }
});
        map.addControl(directions, 'top-left');
        directions.setDestination(coordinates);

        if (navigator.geolocation) {
            watchId = navigator.geolocation.watchPosition(
                position => {
                    const userLoc = [position.coords.longitude, position.coords.latitude];
                    directions.setOrigin(userLoc);
                    
                    map.flyTo({
                        center: userLoc,
                        speed: 0.8,
                        essential: true 
                    });

                    if (btn) btn.innerText = "Live Tracking Active";
                    directionsLoaded = true;
                }, 
                error => {
                    console.error("Tracking error:", error);
                    alert("GPS signal lost. Please enable location permissions.");
                },
                { enableHighAccuracy: true, timeout: 10000 }
            );
        } else {
            alert("Your browser doesn't support live tracking.");
        }
    }

    async function fetchWeather(lat, lon) {
        if (!weatherKey) return console.error("Weather API key missing");
        try {
            const response = await fetch(`https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&units=metric&appid=${weatherKey}`);
            const data = await response.json();
            
            if (response.ok) {
                document.getElementById("weather-widget").innerHTML = `
                    <div class="card-body">
                        <h5 class="card-title text-primary"><i class="fa-solid fa-cloud-sun"></i> Weather at Destination</h5>
                        <p class="m-0"><strong>${data.name}</strong></p>
                        <h3 class="fw-bold text-dark my-1">${data.main.temp}°C</h3>
                        <p class="card-text text-capitalize text-muted small">${data.weather[0].description}</p>
                    </div>`;
            }
        } catch (err) { console.error("Weather failed", err); }
    }

    function calculateFootprint() {
        const transport = document.getElementById("transport").value;
        const dist = 500; 
        const factors = { flight: 0.25, car: 0.15, train: 0.05 };
        const result = (dist * factors[transport]).toFixed(2);
        document.getElementById("footprint-result").innerHTML = 
            `Trip emissions: <b>${result} kg CO₂</b>`;
        if (directions) {
            if (transport === 'car') {
                directions.setProfile('mapbox/driving-traffic');
            } else if (transport === 'train') {
                directions.setProfile('mapbox/cycling');
            }
        }
    }
</script>