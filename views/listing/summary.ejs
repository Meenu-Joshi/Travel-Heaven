<% layout('layout/boilerplate') -%>
<div class="container mt-5 px-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-danger text-white py-3 px-4">
                    <h3 class="mb-0 fw-bold"><i class="fa-solid fa-file-invoice me-2"></i> Reservation Review Summary</h3>
                </div>
                <div class="card-body p-4 bg-light-subtle">
                    <h4 class="text-secondary mb-3"><%= listing.title %></h4>
                    <p class="text-muted mb-4"><i class="fa-solid fa-location-dot text-danger"></i> <%= listing.location %>, <%= listing.country %></p>
                    
                    <hr class="opacity-10 mb-4">
                    
                    <div class="row g-3 text-start">
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block text-uppercase letter-spacing-1">Check-In</small>
                            <strong class="fs-5 text-dark"><%= new Date(checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
                        </div>
                        <div class="col-6 col-md-4">
                            <small class="text-muted d-block text-uppercase letter-spacing-1">Check-Out</small>
                            <strong class="fs-5 text-dark"><%= new Date(checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></strong>
                        </div>
                        <div class="col-12 col-md-4">
                            <small class="text-muted d-block text-uppercase letter-spacing-1">Occupancy Load</small>
                            <strong class="fs-5 text-dark"><%= guests %> Registered Guest(s)</strong>
                        </div>
                    </div>

                    <div class="bg-danger-subtle p-3 rounded-3 mt-4 d-flex justify-content-between align-items-center border border-danger-subtle">
                        <span class="fs-5 fw-bold text-danger-emphasis">Total Gross Valuation:</span>
                        <span class="fs-3 fw-black text-danger">₹<%= totalPrice.toLocaleString('en-IN') %></span>
                    </div>

                    <div class="mt-4 d-grid gap-2">
                        <button id="pay-btn" class="btn btn-danger btn-lg rounded-5 py-2 fw-bold shadow-sm">
                            <i class="fa-solid fa-credit-card me-2"></i> Proceed to Secure Payment Gateway
                        </button>
                        <a href="/listings/<%= listing._id %>" class="btn btn-link text-muted text-decoration-none text-center small mt-2">
                            <i class="fa-solid fa-arrow-left-long"></i> Revoke Transaction & Exit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
document.getElementById('pay-btn').onclick = function(e){
    e.preventDefault();
    
    // Absolute dynamic configuration options map block
    var options = {
        "key": "<%= razorpay_key %>", 
        "amount": "<%= order.amount %>", 
        "currency": "<%= order.currency %>",
        "name": "WanderLust Marketplace",
        "description": "Secure Stay Reservation Token Assignment",
        "order_id": "<%= order.id %>",
        
        "handler": async function (response) {
            try {
                // EXPLICIT ABSOLUTE PATH ALIGNMENT FIX APPLIED HERE
                const verifyRes = await fetch("/listings/<%= listing._id %>/bookings/verify-payment", {
                    method: "POST",
                    headers: { 
                        "Content-Type": "application/json" 
                    },
                    body: JSON.stringify({
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_signature: response.razorpay_signature,
                        listingId: "<%= listing._id %>"
                    })
                });

                const data = await verifyRes.json();
                
                if (data.status === "success") {
                    // Force absolute browser location forwarding upon valid server validation approvals
                    window.location.href = data.redirectUrl;
                } else {
                    alert("Payment Validation Rejected: " + data.message);
                }
            } catch (err) {
                console.error("Asynchronous checkout processing failure:", err);
                alert("Critical network handshake connection timeout error.");
            }
        },
        "prefill": {
            "name": "Meenu Joshi"
        },
        "theme": { 
            "color": "#fe424d" 
        }
    };
    
    var rzp1 = new Razorpay(options);
    
    rzp1.on('payment.failed', function (response){
        alert("Transaction Aborted! Reason: " + response.error.description);
    });
    
    rzp1.open();
}
</script>