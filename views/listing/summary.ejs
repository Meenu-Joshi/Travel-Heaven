<% layout('layout/boilerplate') -%>
<div class="row mt-3 mb-5 ">
    <div class="col-md-6 offset-md-3">
        <h2 class="text-center mb-4">Confirm Your Stay</h2>
        
        <div class="card booking-summary-card shadow">
            <div class="card-header bg-dark text-white text-center">
                <h4>Booking Invoice</h4>
            </div>
            <div class="card-body p-5">
                <h5 class="card-title text-primary"><%= listing.title %></h5>
                <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
                <hr>
                
                <div class="row mb-3">
                    <div class="col-6">
                        <p class="mb-0"><strong>Check-In:</strong></p>
                        <p><%= checkIn %></p>
                    </div>
                    <div class="col-6">
                        <p class="mb-0"><strong>Check-Out:</strong></p>
                        <p><%= checkOut %></p>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span>Price per night:</span>
                    <span>&#8377; <%= listing.price.toLocaleString("en-IN") %></span>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span>Cleaning & Service Fee:</span>
                    <span>&#8377; 500</span>
                </div>
                
                <hr>
                <!-- <div class="d-flex justify-content-between align-items-center fw-bold fs-5 mb-4">
                    <span>Total (INR):</span>
                    <span class="text-success">&#8377; <%= (totalPrice + 500).toLocaleString("en-IN") %></span>
                </div> -->
<div class="card-body">
    <h5 class="mt-4">Select Payment Method</h5>
    <form action="/listings/<%= listing._id %>/final" method="POST" id="payment-form">
        <input type="hidden" name="booking[checkIn]" value="<%= checkIn %>">
        <input type="hidden" name="booking[checkOut]" value="<%= checkOut %>">

        <div class="list-group mb-3">
            <label class="list-group-item d-flex gap-3">
                <input class="form-check-input flex-shrink-0" type="radio" name="paymentMethod" value="UPI" checked>
                <span>
                    <strong>UPI / GPay</strong>
                    <small class="d-block text-muted">Scan the QR code below</small>
                </span>
            </label>

           

            <label class="list-group-item d-flex gap-3">
                <input class="form-check-input flex-shrink-0" type="radio" name="paymentMethod" value="COD">
                <span>
                    <strong>Pay at Property (COD)</strong>
                    <small class="d-block text-muted">Pay during check-in</small>
                </span>
            </label>
        </div>

        <div id="qr-section" class="text-center p-3 bg-light rounded border mb-3">
            <p class="mb-2"><strong>Scan to Pay</strong></p>
            <img src="<%= qrCodeImage %>" alt="QR Code" class="img-fluid" style="max-width: 150px;">
        </div>

        <button class="btn btn-danger w-100 py-2">Confirm Booking</button>
    </form>
</div>

<!-- 
                <div class="payment-section text-center p-3 bg-light rounded border">
                    <p class="mb-2"><strong>Scan with GPay or any UPI App</strong></p>
                    <img src="<%= qrCodeImage %>" alt="Payment QR Code" class="img-fluid qr-code mb-3">
                    <p class="small text-muted">Merchant: WanderLust Payments</p>
                </div>

                <form action="/listings/<%= listing._id %>/final" method="POST" class="mt-4">
                    <button class="btn btn-danger w-100 py-2 fs-5 shadow-sm">Complete Booking</button>
                </form> -->
            </div>
        </div>
    </div>
</div>

<script>
    // Logic to hide/show QR code based on selection
    const radios = document.querySelectorAll('input[name="paymentMethod"]');
    const qrSection = document.getElementById('qr-section');

    radios.forEach(radio => {
        radio.addEventListener('change', (e) => {
            if (e.target.value === 'UPI') {
                qrSection.style.display = 'block';
            } else {
                qrSection.style.display = 'none';
            }
        });
    });
</script>